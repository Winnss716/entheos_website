<?xml version="1.0" encoding="utf-8"?>
	<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
		<Metadata>
			<Identity Language="en-US" Id="phone-preview" Version="3.1.1" Publisher="lirobi" />
			<DisplayName>Mobile Preview - Phone &amp; Tablet Simulator</DisplayName>
			<Description xml:space="preserve">Preview web apps in iPhone, Android &amp; iPad frames with live reload. Test responsive designs instantly without leaving VS Code.</Description>
			<Tags>mobile,preview,responsive,phone,iphone,android,ipad,tablet,simulator,device,viewport,testing,web development,react,vue,pwa,live reload,hot reload,mobile-first,ui testing,keybindings</Tags>
			<Categories>Testing,Visualization,Other</Categories>
			<GalleryFlags>Public</GalleryFlags>
			<Badges><Badge Link="https://mobilepreview.lirobi.com/pricing" ImgUri="https://img.shields.io/badge/price-%245%20lifetime-success" Description="One-time payment" /></Badges>
			<Properties>
				<Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.60.0" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace" />
				<Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
				
				
				<Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="https://github.com/Lirobi/phoneviewvscode.git" />
